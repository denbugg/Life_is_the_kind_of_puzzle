    "not_a_quality_result": true,
    "not_full_basincycle": true,
    "implemented_core": [
      "ten-channel corruption-visible tile preprocessing",
      "full-resolution stride-one 20x20 boundary encoder with no spatial reduction",
      "ordered four-side 20-sample sequences and learned right/down pair logits",
      "external frozen Socket-v2 6x6 strict warm-start control for half the states",
      "current-layout realised-contact features and three local 3x3 state blocks",
      "target-free detached dynamic proposal closure",
      "KEEP at proposal index zero and atomic strict closed 2/3-cycles only",
      "current-state/action utility with pair/exact/radius2 quantiles and pair-loss risk",
      "strict hard-permutation output with original upright tile identities"
    ],
    "explicit_omissions_from_full_design": [
      "no deep top-64 cross-pair 1D encoder; the 6x6 pilot uses shallow ordered-side projected dot products",
      "no sparse top-64 candidate-graph attention; state context is local 3x3 grid convolution",
      "no prefix-conditioned pointer decoder; the bank enumerates bounded 2/3-cycles from detached pair logits",
      "no length-4-to-8 cycles",
      "no oracle-continuation or attraction-basin target; positives are all one-step lexicographically best non-worsening actions",
      "no multi-step learned rollout evaluation; one selected cycle is compared with KEEP",
      "no 12x12 or 24x24 scaling claim"
    ],
    "closed_families_not_reintroduced": [
      "continuous Sinkhorn solver state",
      "full N-by-N assignment replacement",
      "independent absolute row/column prediction",
      "cold-start image or permutation DDPM",
      "standalone denoiser output",
      "rendered or generated replacement pixels"
    ]
  },
