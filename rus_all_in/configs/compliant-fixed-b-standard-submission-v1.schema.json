{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiijc-puzzle.local/schemas/fixed-b-standard-submission-compliance-v1.json",
  "title": "AIIJC fixed-B standard submission compliance attestation",
  "description": "Fail-closed evidence for corresponding-input provenance, a strict upright 576-tile bijection, independent-tile official DRUNet50, and the fixed t60 protected h28/h50 tail. It does not claim hidden-layout correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "scope",
    "correct_hidden_layout_proven",
    "proof_limitation",
    "method",
    "policy",
    "promotion_evidence",
    "runtime_manifest",
    "input_snapshot",
    "archive",
    "canonical_execution",
    "per_board"
